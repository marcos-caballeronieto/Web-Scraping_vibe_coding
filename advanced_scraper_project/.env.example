# Environment configuration for the advanced Python Scraper
# Duplicate this file to .env and fill in your details

# Your OpenAI API key for using the LLM structured outputs data extraction step
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) A comma separated list of proxies for rotation
# Format typically looks like: http://username:password@proxy_ip:port
PROXY_LIST=http://127.0.0.1:8080,http://192.168.1.100:8000
